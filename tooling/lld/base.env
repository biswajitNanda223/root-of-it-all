# shellcheck shell=bash
# Layer 1: repo-wide. Only sets what is safe for every project.
export CC="${CC:-clang}" CXX="${CXX:-clang++}"
# setuptools links shared objects via LDSHARED (sysconfig default is gcc) - pin it to the same driver.
export LDSHARED="${CC} -shared"
export LDFLAGS="-fuse-ld=lld -Wl,--as-needed -Wl,-z,relro,-z,now ${LDFLAGS_EXTRA:-}"
export RUSTFLAGS="-C link-arg=-fuse-ld=lld ${RUSTFLAGS_EXTRA:-}"
export CFLAGS="-fstack-protector-strong -D_FORTIFY_SOURCE=2 ${CFLAGS_EXTRA:-}"
