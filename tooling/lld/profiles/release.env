# shellcheck shell=bash
# Small + fast artifacts: ThinLTO, section GC, identical-code folding, reproducible build-id.
export CFLAGS="$CFLAGS -O2 -ffunction-sections -fdata-sections -flto=thin"
export LDFLAGS="$LDFLAGS -flto=thin -Wl,--gc-sections -Wl,--icf=safe -Wl,-O2 -Wl,--build-id=sha1 -Wl,--thinlto-cache-dir=${LLD_CACHE_DIR:-/tmp/lld-thinlto}"
export RUSTFLAGS="$RUSTFLAGS -C lto=thin -C codegen-units=1"
