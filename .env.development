# Development defaults - committed in plaintext on purpose: nothing here is secret.
# Personal tweaks: .env.local (git-ignored). Staging/production: `scripts/env.sh init <env>` (encrypted).
RIO_ENVIRONMENT=development
RIO_LOG_LEVEL=DEBUG
RIO_DATABASE_URL=sqlite+aiosqlite:///./dev.db
RIO_AUTO_CREATE_TABLES=true
RIO_SECRET_KEY=dev-only-insecure-secret-key-0000
RIO_PLAYGROUND_ENABLED=true
RIO_FIRST_SUPERUSER_EMAIL=admin@example.com
RIO_FIRST_SUPERUSER_PASSWORD=admin-password-dev
POSTGRES_PASSWORD=postgres
