# Context is the whole monorepo: send as little as possible.
**
!pyproject.toml
!uv.lock
!tooling/lld/**
!apps/**
!packages/**
!scripts/**
!.env.example
# ...then re-exclude noise inside the allowed trees
**/__pycache__
**/*.py[cod]
**/*.so
**/build
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.db
