# Reference of every supported variable (all use the RIO_ prefix). Not loaded by anything.
#
# How configuration is loaded (docs/secrets.md):
#   shell/CI env  >  .env.local  >  .env.<environment>   (dotenvx; staging/production files are ENCRYPTED)
#
# development : edit .env.development (plaintext, committed) or put overrides in .env.local
# staging/prod: scripts/env.sh init staging|production ; scripts/env.sh set <env> KEY VALUE

RIO_ENVIRONMENT=development          # development | test | staging | production
RIO_DEBUG=false
RIO_LOG_LEVEL=INFO
RIO_LOG_JSON=false
RIO_DATABASE_URL=sqlite+aiosqlite:///./dev.db
RIO_AUTO_CREATE_TABLES=false          # dev/test convenience only; use scripts/migrate.sh elsewhere
RIO_SECRET_KEY=change-me-in-production  # required in staging/production
RIO_ACCESS_TOKEN_EXPIRE_MINUTES=30
RIO_CORS_ORIGINS=[]
RIO_ALLOWED_HOSTS=["*"]
RIO_DOCS_ENABLED=true
RIO_PLAYGROUND_ENABLED=true           # MUST be false in production
RIO_PLAYGROUND_API_KEY=demo-key
RIO_PUBLIC_URL=                       # advertised in OpenAPI `servers` behind a proxy
# --- multi-service (docs/services.md): each service owns its database ---
RIO_SERVICE_KEY=dev-service-key        # service-to-service credential (required outside dev)
CATALOG_DATABASE_URL=sqlite+aiosqlite:///./catalog.db
ORDERS_DATABASE_URL=sqlite+aiosqlite:///./orders.db
CATALOG_URL=http://localhost:8001      # where orders finds catalog
IDENTITY_TOKEN_URL=http://localhost:8000/api/v1/auth/token   # Swagger *Authorize* target
RIO_FIRST_SUPERUSER_EMAIL=
RIO_FIRST_SUPERUSER_PASSWORD=
RIO_MAX_UPLOAD_BYTES=5242880

# docker compose only
POSTGRES_PASSWORD=postgres
# dotenvx private keys (NEVER commit; provide via CI/secret manager or the untracked .env.keys)
# DOTENV_PRIVATE_KEY_STAGING=
# DOTENV_PRIVATE_KEY_PRODUCTION=
