# Copy to .env (scripts/bootstrap.sh does this). All settings use the RIO_ prefix.
RIO_ENVIRONMENT=development          # development | test | staging | production
RIO_DEBUG=false
RIO_LOG_LEVEL=INFO
RIO_LOG_JSON=false
RIO_DATABASE_URL=sqlite+aiosqlite:///./dev.db
RIO_AUTO_CREATE_TABLES=true           # false outside dev/test; use scripts/migrate.sh
RIO_SECRET_KEY=change-me-in-production  # required in staging/production: `openssl rand -hex 32`
RIO_ACCESS_TOKEN_EXPIRE_MINUTES=30
RIO_CORS_ORIGINS=[]
RIO_ALLOWED_HOSTS=["*"]
RIO_DOCS_ENABLED=true
RIO_PLAYGROUND_ENABLED=true           # dummy end-to-end APIs; MUST be false in production
RIO_PLAYGROUND_API_KEY=demo-key
# RIO_PUBLIC_URL=https://api.example.com  # advertised in OpenAPI `servers` behind a proxy
# RIO_FIRST_SUPERUSER_EMAIL=admin@example.com
# RIO_FIRST_SUPERUSER_PASSWORD=change-me-now

# docker compose only
POSTGRES_PASSWORD=postgres
